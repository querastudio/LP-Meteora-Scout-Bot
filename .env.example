# --- wajib ---
TELEGRAM_BOT_TOKEN=
# ID Telegram numerik milik Anda (tanya @userinfobot). Hanya ID ini yang dilayani bot.
TELEGRAM_OWNER_ID=

# --- opsional ---
# Disarankan RPC pribadi (Alchemy/Helius/QuickNode); RPC publik sering membatasi getTokenLargestAccounts.
RPC_URL=https://api.mainnet-beta.solana.com
DB_PATH=data/lpscout.db
SCAN_PAGES=6
# Aset yang tidak dianggap (pisahkan koma). Kosongkan untuk memakai bawaan.
EXCLUDED_SYMBOLS=

# --- ambang (nilai bawaan; bisa juga diubah dari Telegram lewat /set) ---
SCAN_MINUTES=15
COOLDOWN_MINUTES=120
TOP_N=20
MIN_BIN_STEP=80
MIN_TVL=10000
MAX_TOP10_PCT=30
IDEAL_FEE_YIELD=0.20
IDEAL_NET_EDGE=0.10
IDEAL_ACTIVITY=0.90
IDEAL_CONCENTRATION=0.10
BAGUS_FEE_YIELD=0.10
BAGUS_NET_EDGE=0.05
BAGUS_ACTIVITY=0.90
BAGUS_CONCENTRATION=0.10
BAGUS_PACE6H=0.50
MINIMAL_FEE_YIELD=0.05
MINIMAL_NET_EDGE=0.02
MINIMAL_ACTIVITY=0.90
MINIMAL_CONCENTRATION=0.10
MINIMAL_PACE6H=0.50
